# Non-secret systemd EnvironmentFile. Install as root:root 0600.
# This is not a shell script: do not use export, command substitution, or $VAR.
# Fill both required model fields with an operator-approved compatible pair.
HXA_TASK_URL=http://127.0.0.1:4801
HXA_RUNNER_ID=pilot-real-worker
HXA_TASK_HEARTBEAT_MS=15000

# The unit sets HXA_TASK_TOKEN_FILE using LoadCredential. Do not put a token here.
# An explicitly reviewed file-only compatibility configuration is documented in
# docs/m1-codex-worker.md. Do not copy the M0 or production model credentials.
# The unit also supplies a non-secret SetCredential=hxa_sandbox_probe marker
# beside that token. All 16 checks, including sandbox boundaries, must pass.

HXA_CODEX_BIN=/opt/hxa-codex-worker/codex/bin/codex
HXA_CODEX_HOME_DIR=/var/lib/hxa-codex-worker
CODEX_HOME=/var/lib/hxa-codex-worker/codex
# Keep model settings below, not in CODEX_HOME/config.toml: the dedicated real-run
# policy preview and exec must use matching sources. Never delete a config automatically.
HXA_CODEX_STATE_DIR=/data/hxa-agent-m1-worker
HXA_CODEX_MODEL=
HXA_CODEX_REASONING_EFFORT=
HXA_CODEX_PROFILE=feedback-demo
HXA_CODEX_CHILD_PATH=/opt/hxa-codex-worker/node/bin:/usr/local/bin:/usr/bin:/bin

# Browser-facing URL, distinct from HXA_TASK_URL. Verify the existing HTTPS
# session on the user's Mac can download a real artifact before acceptance.
HXA_ARTIFACT_PUBLIC_BASE_URL=https://35.73.61.176

# Bounded pilot execution. Keep these defaults for the initial acceptance.
HXA_CODEX_TASK_TIMEOUT_MS=1800000
HXA_CODEX_TERM_GRACE_MS=10000
HXA_CODEX_MAX_STDOUT_BYTES=8388608
HXA_CODEX_MAX_STDERR_BYTES=2097152
HXA_CODEX_MAX_RESULT_BYTES=65536
HXA_CODEX_MAX_FILE_BYTES=5242880
HXA_CODEX_MAX_ARTIFACT_BYTES=10485760
HXA_CODEX_MIN_FREE_BYTES=1073741824
HXA_CODEX_UPLOAD_TIMEOUT_MS=30000

# At most 19 user artifacts plus one audit artifact. The 10 MiB total includes
# metadata. One file is limited to 5 MiB; the final result is limited to 64 KiB.
# Keep TimeoutStopSec >= 30 s and greater than the worker's TERM grace.
