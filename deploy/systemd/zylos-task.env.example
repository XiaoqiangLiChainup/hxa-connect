# Additive, non-secret systemd EnvironmentFile. Install as root:root 0600 at
# /etc/hxa-codex-worker/zylos-task.env. This is not a shell script.
# Keep the existing codex-worker.env, dedicated login, model pair, and paths.
# The token stays in LoadCredential; never put its value in this file.

# Exact expiry from the existing pilot token's issuance record. This setting
# does not authenticate, extend, renew, or replace that token.
HXA_ZYLOS_TOKEN_EXPIRES_AT=2026-11-04T06:38:16.417Z

# Minimum five minutes; must also cover configured finish retries and cleanup.
# The window is checked before every claim. A 30-minute task with this reserve
# must start strictly before 2026-11-04T06:03:16.417Z.
HXA_ZYLOS_STOP_RESERVE_MS=300000

# No shared Zylos path/runtime or bypass overrides are supported. Do not set
# ZYLOS_DIR, HXA_ZYLOS_CORE_DIR, HXA_ZYLOS_RUNTIME, or CODEX_BYPASS_PERMISSIONS.
# The source loader uses only the complete pinned vendor tree in this release.
