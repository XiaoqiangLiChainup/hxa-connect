# Example fragment for an EXISTING host Nginx http context.
# Replace the hostname/certificate paths and validate with nginx -t before use.
# If Nginx is in another container, use a deliberately configured shared network
# and the Hub service name instead of this host-loopback upstream.
map $http_upgrade $hxa_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name agent.company.example;

    ssl_certificate     /etc/nginx/tls/agent.company.example/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/agent.company.example/privkey.pem;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:4801;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hxa_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
