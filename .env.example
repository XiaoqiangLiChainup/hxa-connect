# Copy to .env and set a randomly generated administrator secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HXA_CONNECT_ADMIN_SECRET=

# Compose publishes only on loopback by default. Set the bind address explicitly
# when exposing the service on a company network or to a reverse proxy host.
HXA_CONNECT_BIND_ADDRESS=127.0.0.1
HXA_CONNECT_PORT=4800

# Public hostname when using a reverse proxy, without scheme or path.
# Leave empty for direct local access; HXA will validate against the request host.
DOMAIN=
HXA_CONNECT_CORS_ORIGINS=
