# Copy to .env and set a randomly generated administrator secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HXA_CONNECT_ADMIN_SECRET=

# Choose once for a new pilot. Keep it stable across release directories so the
# same named data volume is reused. Do not change an existing deployment blindly.
COMPOSE_PROJECT_NAME=hxa-agent-pilot

# Local image built from this M0 checkout. The optional mock runner uses this
# same image; this is not a prepublished image from an external registry.
HXA_CONNECT_IMAGE=hxa-agent-platform:m0-local

# Compose publishes only on loopback by default. Set the bind address explicitly
# when exposing the service on a company network or to a reverse proxy host.
HXA_CONNECT_BIND_ADDRESS=127.0.0.1
HXA_CONNECT_PORT=4800

# Public hostname when using a reverse proxy, without scheme or path.
# Leave empty for direct local access; HXA will validate against the request host.
# The dashboard uses Secure cookies in normal mode. Use HTTPS for company access.
DOMAIN=
HXA_CONNECT_CORS_ORIGINS=

# Optional: used only when deploy/compose.mock-runner.yml is explicitly loaded.
HXA_RUNNER_ID=mock-server-check
HXA_MOCK_DELAY_MS=1000
# Supply HXA_TASK_TOKEN locally through your shell or private .env. It must be
# the assigned bot's full-scope token, never the administrator secret. Do not
# put real tokens in this example or commit them to the repository.
